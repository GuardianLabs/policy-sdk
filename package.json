{
  "name": "root",
  "license": "proprietary",
  "version": "0.3.3",
  "description": "Guardian Policies SDK",
  "scripts": {
    "build:all": "pnpm -r build",
    "clean:all": "pnpm -r clean",
    "check:all": "pnpm -r check",
    "increase-packages-version": "cross-env-shell \"pnpm -r version $npm_package_version\" && git add **/package.json",
    "publish-packages": "cross-env-shell \"pnpm -r publish-package\"",
    "remove:node_modules": "rm -rf node_modules",
    "version": "pnpm increase-packages-version",
    "test:all": "pnpm -r test"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "pnpm": {
    "overrides": {
      "elliptic": "^6.6.1",
      "@ethersproject/providers": "5.8.0"
    }
  }
}
