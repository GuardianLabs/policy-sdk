{
  "name": "root",
  "license": "proprietary",
  "version": "0.1.3",
  "description": "Guardian Policies SDK",
  "scripts": {
    "build:all": "pnpm -r build",
    "clean:all": "pnpm -r clean",
    "check:all": "pnpm -r check",
    "remove:node_modules": "rm -rf node_modules",
    "increase-version": "cross-env-shell \"pnpm -r version $npm_package_version\" && git add **/package.json",
    "publish-packages": "cross-env-shell \"pnpm -r publish-package\"",
    "version": "pnpm increase-version",
    "test:all": "pnpm -r test"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  },
  "publishConfig": {
    "@guardian-network:registry": "https://gitlab.com/api/v4/projects/69589082/packages/npm/"
  }
}
