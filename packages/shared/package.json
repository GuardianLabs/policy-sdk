{
  "name": "@guardian-network/shared",
  "author": "v.grabovski@lacero.io, vpriadko@lacero.io",
  "description": "A shared tools, types, interfaces of Policy SDK",
  "version": "0.3.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuardianLabs/policy-sdk/"
  },
  "license": "MIT",
  "homepage": "https://github.com/GuardianLabs/policy-sdk/tree/dev/packages/shared#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18.20.4"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "pnpm format:all:fix && tsc -p tsconfig-prod.json && pnpm copy-dts",
    "check": "pnpm lint:ts && pnpm check:ts",
    "check:ts": "tsc -p tsconfig-prod.json --noEmit",
    "check:ts:dev": "tsc -p tsconfig.json --noEmit",
    "clean": "pnpm remove:dist",
    "copy-dts": "copyfiles -u 1 \"src/**/*.d.ts\" dist",
    "format:all:fix": "pnpm format:ts:fix",
    "format:ts:fix": "prettier -w -c \"src/**/*.ts\"",
    "lint:ts": "eslint",
    "lint:ts:fix": "eslint --fix",
    "publish-package": "pnpm publish --no-git-checks",
    "remove:dist": "npx rimraf dist",
    "test": "mocha",
    "tests:coverage:ts": "nyc pnpm test",
    "version": "pnpm version"
  },
  "keywords": [],
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.13.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.8.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.8.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-mocha": "^10.5.0",
    "eslint-plugin-n": "^17.10.3",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.11.0",
    "mocha": "^10.8.2",
    "nyc": "^18.0.0",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "rimraf": "^6.0.1"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.16.0",
    "typescript": "^5.6.2"
  }
}
