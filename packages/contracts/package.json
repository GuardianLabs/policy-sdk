{
  "name": "@guardian-network/policy-contracts",
  "author": "v.grabovski@lacero.io, vpriadko@lacero.io",
  "description": "Policy with dynamic conditions defined onchain",
  "version": "0.3.1",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "/contracts/**/*.sol",
    "/predefined-artifacts-exports/**/*.lac"
  ],
  "engines": {
    "node": ">=18.20.4"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "pnpm format:all:fix && pnpm build:contracts && tsc -p tsconfig-prod.json && pnpm copy-dts",
    "build:contracts": "pnpm exec hardhat compile",
    "build:contracts:force": "pnpm build:contracts --force",
    "check": "pnpm lint:ts && pnpm check:ts",
    "check:ts": "tsc -p tsconfig-prod.json --noEmit",
    "check:ts:dev": "tsc -p tsconfig.json --noEmit",
    "clean": "pnpm remove:dist && pnpm remove:contracts && pnpm remove:typechain",
    "copy-dts": "copyfiles -u 1 \"src/**/*.d.ts\" dist",
    "deployAndExport:amoy": "pnpm deployAndExport:noNetwork amoy",
    "deployAndExport:noNetwork": "pnpm exec hardhat run hardhat-scripts/deployAndExport.ts --network",
    "format:all:fix": "pnpm format:sol:fix && pnpm format:ts:fix",
    "format:ts:fix": "pnpm exec prettier -w -c \"src/**/*.ts\" \"test/**/*.ts\" \"config-hardhat/**/*.ts\" \"ignition/**/*.ts\" \"hardhat-scripts/**/*.ts\"",
    "format:sol:fix": "pnpm exec prettier --plugin=prettier-plugin-solidity -w -c \"contracts/**/*.sol\"",
    "generate-errors": "pnpm exec ts-node src/constants/generate-errors-enum.ts",
    "lint:sol": "pnpm exec solhint -f table --max-warnings 0 'contracts/**/*.sol'",
    "lint:sol:fix": "pnpm exec solhint --noPrompt -f table 'contracts/**/*.sol' --fix",
    "lint:ts": "eslint",
    "lint:ts:fix": "eslint --fix",
    "local:development:node": "pnpm exec hardhat node --network hardhat",
    "publish-package": "pnpm publish --no-git-checks",
    "remove:contracts": "pnpm exec hardhat clean",
    "remove:dist": "pnpm exec rimraf dist",
    "remove:typechain": "pnpm exec rimraf src/typechain",
    "test": "pnpm test:contracts",
    "test:contracts": "pnpm exec hardhat test --bail",
    "tests:coverage:sol": "pnpm exec hardhat coverage --testfiles 'test/**/*.ts'",
    "tests:coverage:ts": "nyc pnpm test",
    "version": "pnpm version"
  },
  "keywords": [],
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.14.0",
    "@faker-js/faker": "^9.9.0",
    "@guardian-network/policy-compiler": "workspace:*",
    "@guardian-network/policy-intermediate-representation": "workspace:*",
    "@guardian-network/policy-variables": "workspace:*",
    "@guardian-network/shared": "workspace:*",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-toolbox": "6.1.2",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@types/chai": "4.3.3",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.8.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.8.0",
    "chai": "^4.5.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-mocha": "^10.5.0",
    "eslint-plugin-n": "^17.13.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.11.0",
    "hardhat": "2.27.2",
    "hardhat-contract-sizer": "^2.10.0",
    "nyc": "^18.0.0",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-solidity": "^1.4.1",
    "rimraf": "^6.0.1",
    "solhint": "^5.0.5"
  },
  "dependencies": {
    "@chainlink/contracts": "1.5.0",
    "@openzeppelin/contracts": "^5.1.0",
    "@solidity-parser/parser": "^0.18.0",
    "dotenv": "^16.4.5",
    "ethers": "6.16.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
